generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

/// Pokemon #1-150 (generacion I)
model Pokemon {
  id              Int     @id
  name            String  @unique
  genus           String?
  flavorText      String?
  height          Int
  weight          Int
  baseExperience  Int?
  captureRate     Int?
  isDefault       Boolean @default(true)

  hp              Int
  attack          Int
  defense         Int
  specialAttack   Int
  specialDefense  Int
  speed           Int

  spriteFront      String?
  spriteBack       String?
  spriteFrontShiny String?
  artworkOfficial  String?

  evolvesFromId   Int?
  evolvesFrom     Pokemon?  @relation("Evolution", fields: [evolvesFromId], references: [id])
  evolvesTo       Pokemon[] @relation("Evolution")

  types     PokemonType[]
  abilities PokemonAbility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([evolvesFromId])
}

model Type {
  id       Int           @id @default(autoincrement())
  name     String        @unique
  pokemons PokemonType[]
}

model PokemonType {
  pokemonId Int
  typeId    Int
  slot      Int

  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  type    Type    @relation(fields: [typeId], references: [id], onDelete: Cascade)

  @@id([pokemonId, typeId])
  @@index([typeId])
}

model Ability {
  id       Int              @id @default(autoincrement())
  name     String           @unique
  pokemons PokemonAbility[]
}

model PokemonAbility {
  pokemonId Int
  abilityId Int
  slot      Int
  isHidden  Boolean @default(false)

  pokemon Pokemon @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  ability Ability @relation(fields: [abilityId], references: [id], onDelete: Cascade)

  @@id([pokemonId, abilityId])
  @@index([abilityId])
}
